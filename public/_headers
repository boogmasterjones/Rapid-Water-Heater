/css/*
  Cache-Control: public, max-age=0, must-revalidate

/js/*
  Cache-Control: public, max-age=0, must-revalidate

/images/*
  Cache-Control: public, max-age=31536000, immutable

# Astro's built CSS and JS have content hashes in their names, so they can be cached for good.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
