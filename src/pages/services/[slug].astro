---
import { render } from 'astro:content';
import { responsiveImages } from '../../lib/images';
import { addCtas } from '../../lib/cta';
import { pageKey, photoBandFor } from '../../lib/photoband';
import Base from '../../layouts/Base.astro';
import { getLocations, getServices } from '../../lib/content';
import { breadcrumbSchema, businessSchema, faqSchema, serviceSchema } from '../../lib/schema';
import { site } from '../../lib/site';

export async function getStaticPaths() {
  const entries = await getServices();
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
// Plain <img> tags in the Markdown get WebP srcsets (lib/images.ts); falls back to the normal render.
const path = `/services/${entry.id}`;
// Every other section ends with a Call / Free Estimate row (lib/cta.ts), the photo band included.
const withCtas = entry.rendered?.html ? addCtas(await responsiveImages(entry.rendered.html), { quoteHref: '/#quote', prefix: pageKey(path), tail: Boolean(photoBandFor(path)) }) : null;
const bodyHtml = withCtas?.html ?? null;
const [services, locations] = await Promise.all([getServices(), getLocations()]);
const business = businessSchema(locations.map((l) => l.data.city), services.map((s) => s.data.name));
const jsonLd = [business, serviceSchema(entry.data.name, entry.data.description, path, [site.business.address.city, ...locations.map((l) => l.data.city)]), breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Services', path: '/services' }, { name: entry.data.name, path }]), ...(entry.data.faqs.length > 0 ? [faqSchema(entry.data.faqs)] : [])];
---

<Base title={entry.data.title} description={entry.data.description} image={entry.data.image} jsonLd={jsonLd} photoBandCta={withCtas?.tailCta ?? false}>
  {bodyHtml !== null ? <Fragment set:html={bodyHtml} /> : <Content />}
</Base>
