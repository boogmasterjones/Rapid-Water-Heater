---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import GlassHero from '../components/glass/GlassHero.astro';
import PhotoCarousel from '../components/glass/PhotoCarousel.astro';
import glass from '../../data/glass.json';
import { getHome, getLocations, getServices } from '../lib/content';
import { businessSchema, faqSchema } from '../lib/schema';

const page = await getHome();
const { Content } = await render(page);
const [services, locations] = await Promise.all([getServices(), getLocations()]);
const jsonLd = [businessSchema(locations.map((l) => l.data.city), services.map((s) => s.data.name)), ...(page.data.faqs.length > 0 ? [faqSchema(page.data.faqs)] : [])];

// content/pages/home.md stays the source of the homepage copy. Comment markers in it (<!-- glass:hero -->,
// <!-- glass:gallery -->) say where the design components go; everything between them is rendered as written.
const html = page.rendered?.html ?? '';
const parts = html ? html.split(/<!--\s*glass:([a-z-]+)\s*-->/) : [];
const { hero, gallery, rating } = glass;
---

<Base title={page.data.title} description={page.data.description} image={page.data.image} jsonLd={jsonLd} bodyClass={page.data.bodyClass} quoteHref="#quote" photoBand={false}>
  {parts.length > 1 ? parts.map((part, i) => {
    if (i % 2 === 0) return <Fragment set:html={part} />;
    if (part === 'hero') return <GlassHero heading={page.data.heading} lede={page.data.subheading} {...hero} rating={rating} />;
    if (part === 'gallery') return <PhotoCarousel {...gallery} />;
    return null;
  }) : <Content />}
</Base>
