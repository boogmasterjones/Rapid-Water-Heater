---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { getHome, getLocations, getServices } from '../lib/content';
import { businessSchema, faqSchema } from '../lib/schema';

const page = await getHome();
const { Content } = await render(page);
const [services, locations] = await Promise.all([getServices(), getLocations()]);
const jsonLd = [businessSchema(locations.map((l) => l.data.city), services.map((s) => s.data.name)), ...(page.data.faqs.length > 0 ? [faqSchema(page.data.faqs)] : [])];
---

<Base title={page.data.title} description={page.data.description} image={page.data.image} jsonLd={jsonLd} bodyClass={page.data.bodyClass}>
  <Content />
</Base>
