---
import { render } from 'astro:content';
import { responsiveImages } from '../lib/images';
import { addCtas } from '../lib/cta';
import { pageKey, photoBandFor } from '../lib/photoband';
import Base from '../layouts/Base.astro';
import { getPages } from '../lib/content';
import { breadcrumbSchema, faqSchema } from '../lib/schema';

export async function getStaticPaths() {
  const pages = await getPages();
  return pages.map((page) => ({ params: { path: page.data.path.replace(/^\//, '') }, props: { page } }));
}

const { page } = Astro.props;
const { Content } = await render(page);
const hasQuote = /id="quote"/.test(page.body ?? '');
// Plain <img> tags in the Markdown get WebP srcsets (lib/images.ts), and every other section ends with a
// Call / Free Estimate row (lib/cta.ts), the photo band included. Falls back to the normal render.
const withCtas = page.rendered?.html
  ? addCtas(await responsiveImages(page.rendered.html), { quoteHref: hasQuote ? '#quote' : '/#quote', prefix: pageKey(page.data.path), tail: Boolean(photoBandFor(page.data.path)) })
  : null;
const jsonLd = [breadcrumbSchema([{ name: 'Home', path: '/' }, { name: page.data.heading.replace(/\*/g, ''), path: page.data.path }]), ...(page.data.faqs.length > 0 ? [faqSchema(page.data.faqs)] : [])];
---

<Base title={page.data.title} description={page.data.description} image={page.data.image} noindex={page.data.noindex} jsonLd={jsonLd} bodyClass={page.data.bodyClass} quoteHref={hasQuote ? '#quote' : undefined} photoBandCta={withCtas?.tailCta ?? false}>
  {withCtas ? <Fragment set:html={withCtas.html} /> : <Content />}
</Base>
