---
import { render } from 'astro:content';
import { responsiveImages } from '../../lib/images';
import Base from '../../layouts/Base.astro';
import Picture from '../../components/Picture.astro';
import { formatDate, getPosts, readingTime } from '../../lib/content';
import { blogPostingSchema, breadcrumbSchema, faqSchema } from '../../lib/schema';
import { site } from '../../lib/site';
import { emHtml } from '../../lib/text';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { data } = post;
const { Content } = await render(post);
// Plain <img> tags in the Markdown get WebP srcsets (lib/images.ts); falls back to the normal render.
const bodyHtml = post.rendered?.html ? await responsiveImages(post.rendered.html) : null;
const path = `/blog/${post.id}`;
const author = data.author ?? site.business.name;
const date = formatDate(data.date);
const minutes = readingTime(post.body ?? '');
// Brand suffix only when the whole title still fits in a search result (~65 characters); otherwise the article title alone.
const suffix = ` | ${site.brand.logoText}`;
const pageTitle = data.title.length + suffix.length <= 65 ? data.title + suffix : data.title;
const jsonLd = [blogPostingSchema({ ...data, path }), breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Blog', path: '/blog' }, { name: data.title, path }]), ...(data.faqs.length > 0 ? [faqSchema(data.faqs)] : [])];
---

<Base title={pageTitle} description={data.description} image={data.image} ogType="article" jsonLd={jsonLd}>
  <section class="page-hero">
    <div class="container">
      <div class="breadcrumbs"><a href="/">Home</a><span class="sep">/</span><a href="/blog">Blog</a><span class="sep">/</span><span aria-current="page">{data.title}</span></div>
      <h1 set:html={emHtml(data.title)} />
      <p class="blog-meta" style="color:var(--text-on-dark-muted);">{data.category ? data.category + ' · ' : ''}{data.updatedAt ? 'Updated ' + formatDate(data.updatedAt) : date} · {minutes}</p>
    </div>
  </section>
  <section>
    <div class="container">
      <div class="content-block" style="max-width:760px;margin:0 auto;">
      {data.image && <Picture src={data.image} alt={data.imageAlt ?? ''} loading="eager" fetchpriority="high" sizes="(max-width: 900px) 100vw, 760px" />}
      {bodyHtml !== null ? <Fragment set:html={bodyHtml} /> : <Content />}
      {data.faqs.length > 0 && (
        <>
          <h2>Frequently Asked Questions</h2>
          <div class="faq-list">{data.faqs.map((f) => (<details class="faq-item"><summary>{f.question}</summary><p>{f.answer}</p></details>))}</div>
        </>
      )}
      </div>
    </div>
  </section>

</Base>
