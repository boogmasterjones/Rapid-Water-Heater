---
// "Meet the team" that turns into "Our work": one continuous strip of real photos (the family first, then their jobs)
// that slides sideways as the visitor scrolls down. The scene holds still on screen only for a short stretch (the strip
// moves about two pixels sideways for each pixel scrolled), and every size is worked out in CSS from the photos' real
// proportions, so nothing on the page moves when the script starts (CLS 0).
// Without the script, or with reduced motion, it is a plain strip you can swipe or scroll sideways.
import Picture from '../Picture.astro';
import { imageInfo } from '../../lib/images';

interface Photo { photo: string; alt: string; caption?: string }
interface Group { kicker: string; heading: string; text: string; photos: Photo[]; link?: { href: string; label: string } }
interface Props { team: Group; work: Group; id?: string }
const { team, work, id = 'team' } = Astro.props;

const withRatio = async (list: Photo[]) => Promise.all(list.map(async (p) => {
  const info = await imageInfo(p.photo);
  return { ...p, ratio: info ? info.width / info.height : 1.5 };
}));
const teamPhotos = await withRatio(team.photos);
const workPhotos = await withRatio(work.photos);
const all = [...teamPhotos, ...workPhotos];
const sumRatio = all.reduce((s, p) => s + p.ratio, 0).toFixed(3);
const gaps = all.length; // gaps between photos, plus the one around the divider tile
---

<section class="gallery" id={id} data-gallery style={`--sum-a:${sumRatio};--gaps:${gaps}`}>
  <h2 class="visually-hidden">{team.kicker} and see {work.kicker.toLowerCase()}</h2>
  <div class="pin">
    <div class="container head">
      <div class="labels" aria-hidden="true">
        <div class="lab lab-team">
          <span class="kicker">{team.kicker}</span>
          <p class="big">{team.heading}</p>
          <p class="sub">{team.text}</p>
        </div>
        <div class="lab lab-work">
          <span class="kicker">{work.kicker}</span>
          <p class="big">{work.heading}</p>
          <p class="sub">{work.text}</p>
        </div>
      </div>
      <div class="meter" aria-hidden="true"><span class="seg team-seg">Team</span><span class="seg work-seg">Work</span><i class="fill"></i></div>
    </div>
    <div class="viewport" tabindex="0" role="region" aria-label={`${team.kicker} and ${work.kicker.toLowerCase()} photos`}>
      <ul class="track" data-track>
        {teamPhotos.map((p, i) => (
          <li class="shot" style={`--a:${p.ratio.toFixed(4)}`}>
            <Picture src={p.photo} alt={p.alt} loading={i < 3 ? 'eager' : 'lazy'} sizes="(max-width: 860px) 70vw, 560px" />
            {p.caption && <span class="cap">{p.caption}</span>}
          </li>
        ))}
        <li class="divider" data-divider aria-hidden="true"><span>{work.kicker}</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></li>
        {workPhotos.map((p) => (
          <li class="shot work" style={`--a:${p.ratio.toFixed(4)}`}>
            <Picture src={p.photo} alt={p.alt} sizes="(max-width: 860px) 70vw, 560px" />
            {p.caption && <span class="cap">{p.caption}</span>}
          </li>
        ))}
      </ul>
    </div>
    {team.link && <p class="container more"><a class="btn btn-navy" href={team.link.href}>{team.link.label}</a></p>}
  </div>
</section>

<script>
  import { RM, clamp } from '../../scripts/glass/env';
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((sec) => {
    const root = document.documentElement;
    if (RM || !root.classList.contains('js') || root.classList.contains('rm')) return;
    const track = sec.querySelector<HTMLElement>('[data-track]');
    const divider = sec.querySelector<HTMLElement>('[data-divider]');
    const viewport = sec.querySelector<HTMLElement>('.viewport');
    if (!track || !divider || !viewport) return;
    let travel = 0, switchAt = 0.5, queued = false, near = false, lastWork: boolean | null = null;
    const measure = () => {
      travel = Math.max(0, track.scrollWidth - viewport.clientWidth);
      // The label turns to "Our work" when the divider tile reaches the middle of the screen.
      switchAt = travel ? clamp((divider.offsetLeft + divider.offsetWidth / 2 - viewport.clientWidth / 2) / travel, 0, 1) : 0.5;
    };
    const update = () => {
      queued = false;
      const r = sec.getBoundingClientRect();
      const p = clamp(-r.top / Math.max(1, r.height - innerHeight), 0, 1);
      track.style.transform = `translate3d(${(-p * travel).toFixed(1)}px,0,0)`;
      sec.style.setProperty('--p', p.toFixed(4));
      const isWork = p >= switchAt;
      if (isWork !== lastWork) { lastWork = isWork; sec.classList.toggle('is-work', isWork); }
    };
    const ask = () => { if (!queued) { queued = true; requestAnimationFrame(update); } };
    measure();
    sec.style.setProperty('--switch', switchAt.toFixed(4));
    update();
    new IntersectionObserver(([e]) => {
      if (e.isIntersecting === near) return;
      near = e.isIntersecting;
      if (near) { measure(); addEventListener('scroll', ask, { passive: true }); ask(); } else removeEventListener('scroll', ask);
    }, { rootMargin: '25% 0px' }).observe(sec);
    addEventListener('resize', () => { measure(); sec.style.setProperty('--switch', switchAt.toFixed(4)); ask(); });
  });
</script>

<style>
  /* ---------- Shared look ---------- */
  .gallery { --gh: 300px; --gap: 16px; --div-w: 132px; --pad: max(var(--gutter), calc((100vw - var(--container)) / 2 + var(--gutter))); padding: 64px 0 40px; }
  .labels { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }
  .lab .big { margin: 0 0 6px; font: 700 var(--fs-h2)/1.06 var(--font-display); color: var(--text-strong); letter-spacing: -0.015em; text-wrap: balance; }
  .lab .sub { margin: 0; max-width: 46ch; font-size: 1.06rem; }
  .meter { display: none; }
  .viewport { overflow-x: auto; scroll-snap-type: x proximity; scrollbar-width: thin; margin-top: 26px; outline-offset: -3px; }
  .track { display: flex; gap: var(--gap); list-style: none; margin: 0; padding: 6px var(--pad) 16px; width: max-content; }
  .shot {
    position: relative; flex: none; margin: 0; height: var(--gh); width: calc(var(--gh) * var(--a)); scroll-snap-align: center;
    border-radius: var(--r-lg); overflow: hidden; border: 1px solid var(--glass-border-strong);
    box-shadow: var(--shadow-2), 0 0 0 6px rgb(255 255 255 / 0.04);
  }
  .shot.work { box-shadow: var(--shadow-2), 0 0 0 6px rgb(245 179 0 / 0.06); }
  .shot :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: center 30%; }
  .cap {
    position: absolute; left: 12px; bottom: 12px; max-width: calc(100% - 24px);
    padding: 7px 12px; border-radius: var(--r-pill); font-size: 0.84rem; font-weight: 700; color: #fff;
    background: var(--glass-fill-strong); border: 1px solid var(--glass-border-strong); box-shadow: var(--glass-edge);
  }
  .divider {
    flex: none; width: var(--div-w); height: var(--gh); display: grid; place-content: center; justify-items: center; gap: 10px;
    border-radius: var(--r-lg); border: 1px dashed rgb(245 179 0 / 0.55); background: rgb(245 179 0 / 0.06);
    color: var(--gold-hi); font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; font-size: 0.78rem; text-align: center;
  }
  .divider svg { width: 26px; height: 26px; }
  .more { margin-top: 18px; margin-bottom: 0; }
  @media (max-width: 760px) {
    .labels { grid-template-columns: 1fr; gap: 18px; }
    .gallery { --gh: 240px; --div-w: 104px; }
  }

  /* ---------- Scroll-driven (script running, motion allowed) ----------
     The section is one screen tall plus a short run; inside it the scene sticks while the strip slides by. Sizes come
     from the photo proportions (--sum-a), so the height is right before any script runs. */
  :global(.js:not(.rm)) .gallery {
    --gh: clamp(220px, calc(100svh - 420px), 400px);
    --pace: 2.2;
    --travel: max(0px, calc(var(--gh) * var(--sum-a) + var(--gap) * var(--gaps) + var(--div-w) + 2 * var(--pad) - 100vw));
    height: calc(100svh + var(--travel) / var(--pace)); padding: 0;
  }
  :global(.js:not(.rm)) .pin {
    position: sticky; top: 0; height: 100svh; overflow: hidden;
    display: flex; flex-direction: column; justify-content: safe center;
    padding: calc(var(--header-top) + var(--header-h) + 12px) 0 20px;
  }
  :global(.js:not(.rm)) .viewport { overflow: hidden; scroll-snap-type: none; margin-top: 22px; }
  :global(.js:not(.rm)) .track { will-change: transform; }
  :global(.js:not(.rm)) .labels { display: grid; grid-template-columns: 1fr; }
  :global(.js:not(.rm)) .lab { grid-area: 1 / 1; transition: opacity 0.45s, transform 0.45s var(--ease-out); }
  :global(.js:not(.rm)) .lab-work { opacity: 0; transform: translateY(16px); }
  .gallery:global(.is-work) .lab-team { opacity: 0; transform: translateY(-16px); }
  .gallery:global(.is-work) .lab-work { opacity: 1; transform: none; }
  :global(.js:not(.rm)) .meter {
    position: relative; display: flex; margin-top: 18px; width: min(360px, 100%); height: 26px; border-radius: var(--r-pill); overflow: hidden;
    background: rgb(255 255 255 / 0.06); border: 1px solid var(--glass-border);
  }
  .seg { position: relative; z-index: 1; display: grid; place-items: center; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-muted); transition: color 0.3s; }
  .team-seg { flex: 0 0 calc(var(--switch, 0.45) * 100%); }
  .work-seg { flex: 1; }
  .gallery:not(:global(.is-work)) .team-seg, .gallery:global(.is-work) .work-seg { color: #fff; }
  .fill { position: absolute; inset: 0; transform-origin: left; transform: scaleX(var(--p, 0)); background: linear-gradient(90deg, rgb(53 167 255 / 0.55), rgb(245 179 0 / 0.55)); }
  @media (max-width: 760px) {
    :global(.js:not(.rm)) .gallery { --gh: clamp(180px, calc(100svh - 500px), 280px); --pace: 2.4; }
    :global(.js:not(.rm)) .lab .big { font-size: clamp(1.6rem, 7vw, 2rem); }
    :global(.js:not(.rm)) .meter { margin-top: 14px; }
    :global(.js:not(.rm)) .viewport { margin-top: 16px; }
    :global(.js:not(.rm)) .more { margin-top: 12px; }
    :global(.js:not(.rm)) .lab .sub { font-size: 0.98rem; }
  }
</style>
