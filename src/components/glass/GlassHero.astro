---
// Homepage hero: the headline over a darker pool (the site-wide drops fall behind it), two calls to action and a
// tilting photo stack with floating badges and the mascot.
import Picture from '../Picture.astro';
import { phoneHref, site } from '../../lib/site';
import { callClick } from '../../lib/track';
import { emHtml } from '../../lib/text';

interface Props {
  heading: string;
  lede?: string;
  eyebrow: string;
  shimmer?: string; // the part of the heading that gets the gold shimmer
  photo: string;
  photoAlt: string;
  photoPosition?: string;
  chips: string[];
  rating?: { value: string; count: number; source: string };
  primaryLabel: string;
  secondaryLabel: string;
  quoteHref?: string;
}
const { heading, lede, eyebrow, shimmer, photo, photoAlt, photoPosition = '50% 50%', chips, rating, primaryLabel, secondaryLabel, quoteHref = '#quote' } = Astro.props;
const safe = emHtml(heading);
const headingHtml = shimmer && heading.includes(shimmer) ? safe.replace(emHtml(shimmer), `<span class="shimmer">${emHtml(shimmer)}</span>`) : safe;
const icons = [
  '<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="13" r="8"/><path d="M12 9v4l2.5 2M9.5 2h5"/></svg>',
  '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2 4 5v6c0 5.2 3.4 9.4 8 11 4.6-1.6 8-5.8 8-11V5l-8-3Z"/><path d="m9 12 2 2 4-4"/></svg>',
];
---

<section class="hero glass-hero" id="top" data-hero>
  <div class="container hero-grid">
    <div class="copy">
      <span class="eyebrow">{eyebrow}</span>
      <h1 set:html={headingHtml} />
      {lede && <p class="lede">{lede}</p>}
      <div class="hero-actions">
        <a class="btn btn-gold" href={phoneHref(site.business.phone)} onclick={callClick('hero_phone_button')}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          {primaryLabel}
        </a>
        <a class="btn btn-outline-light" href={quoteHref}>{secondaryLabel}</a>
      </div>
    </div>
    <div class="stack" data-stack>
      <div class="card3d" style={`--pos:${photoPosition}`}>
        <Picture src={photo} alt={photoAlt} loading="eager" fetchpriority="high" sizes="(max-width: 860px) 92vw, 520px" />
        <div class="glare" aria-hidden="true"></div>
      </div>
      {chips.map((c, i) => <span class={`chip chip-${i}`}><Fragment set:html={icons[i] ?? ''} />{c}</span>)}
      {rating && (
        <span class="chip chip-rating"><span class="st" aria-hidden="true">★</span> {rating.value} on {rating.source} · {rating.count} reviews</span>
      )}
      <Picture src="/images/mascot-logo.png" alt="" class="mascot" loading="eager" />
    </div>
  </div>
</section>

<script>
  import { tilt } from '../../scripts/glass/core';
  document.querySelectorAll<HTMLElement>('[data-hero]').forEach((hero) => {
    const stack = hero.querySelector<HTMLElement>('[data-stack]');
    if (stack) tilt(stack, 9, hero);
  });
</script>

<style>
  .glass-hero {
    position: relative; isolation: isolate; perspective: 1400px;
    display: flex; align-items: center; min-height: var(--vh, 100svh);
    padding: calc(var(--header-top) + var(--header-h) + 40px) 0 70px;
  }
  /* A darker pool behind the words so the background drops never fight the headline. */
  .glass-hero::before { content: ""; position: absolute; inset: 0; z-index: -1; pointer-events: none; background: radial-gradient(60% 70% at 24% 50%, rgb(7 15 38 / 0.7), rgb(7 15 38 / 0.25) 60%, transparent 80%); }
  .hero-grid { display: grid; grid-template-columns: 1.08fr 0.92fr; gap: 56px; align-items: center; }
  h1 { font-size: clamp(2.3rem, 1.3rem + 3.2vw, 4.1rem); line-height: 1.04; margin: 0 0 18px; text-shadow: 0 4px 30px rgb(7 15 38 / 0.6); }
  .lede { max-width: 50ch; margin: 0 0 30px; font-size: 1.15rem; color: #dbe6f8; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 14px; }
  .btn { padding: 15px 28px; }

  .stack { position: relative; transform-style: preserve-3d; transition: transform 0.15s ease-out; max-width: 520px; justify-self: center; width: 100%; }
  .card3d {
    position: relative; overflow: hidden; aspect-ratio: 4 / 5; border-radius: 28px; transform: translateZ(0);
    border: 1px solid rgb(255 255 255 / 0.28);
    box-shadow: var(--shadow-3), 0 0 0 8px rgb(255 255 255 / 0.06), 0 0 70px rgb(53 167 255 / 0.25);
  }
  .card3d :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: var(--pos, 58% 50%); }
  .card3d .glare { opacity: 1; }
  .chip {
    position: absolute; display: inline-flex; align-items: center; gap: 8px; padding: 11px 18px; border-radius: 16px; white-space: nowrap;
    background: var(--glass-fill-strong); border: 1px solid var(--glass-border-strong);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.25), 0 14px 30px rgb(0 0 0 / 0.35);
    color: #fff; font-weight: 700; font-size: 0.92rem;
    transform: translateZ(60px); animation: float 6s ease-in-out infinite;
  }
  .chip :global(svg) { width: 17px; height: 17px; fill: none; stroke: var(--gold); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .chip-0 { left: -8%; top: 12%; }
  .chip-1 { left: -12%; bottom: 22%; animation-delay: -2s; }
  .chip-rating { right: -6%; top: -3%; animation-delay: -4s; }
  .st { color: var(--gold); }
  .stack :global(.mascot) {
    position: absolute; width: 42%; right: -9%; bottom: -8%; height: auto;
    transform: translateZ(90px); filter: drop-shadow(0 22px 24px rgb(0 0 0 / 0.45));
    animation: float var(--float-period) ease-in-out infinite;
  }

  @media (max-width: 860px) {
    .glass-hero { padding: calc(var(--header-top) + var(--header-h) + 28px) 0 56px; }
    .hero-grid { grid-template-columns: 1fr; gap: 44px; }
    .eyebrow { font-size: 0.68rem; letter-spacing: 0.08em; padding: 8px 14px; }
    .lede { font-size: 1.05rem; }
    .hero-actions .btn { flex: 1 1 100%; }
    .chip { font-size: 0.84rem; padding: 9px 14px; }
    .chip-0 { left: 2%; }
    .chip-1 { left: 2%; }
    .chip-rating { right: 2%; }
    .stack :global(.mascot) { width: 34%; right: -2%; }
  }
</style>
