---
// Real-people photo strip shown above the footer. Photos and per-page copy live in data/photos.json,
// keyed by page path, so content rewrites never touch them. `cta` adds the Call / Free Estimate row when the
// page's alternation (src/lib/cta.ts) gives this last section one.
import Picture from './Picture.astro';
import CtaRow from './CtaRow.astro';
import { pageKey, photoBandFor } from '../lib/photoband';

interface Props { cta?: boolean; quoteHref?: string }
const { cta = false, quoteHref = '/#quote' } = Astro.props;
const band = photoBandFor(Astro.url.pathname);
---

{
  band && (
    <section class="photo-band">
      <div class="container">
        <div class="section-head center">
          <h2>{band.title}</h2>
          <p>{band.lede}</p>
        </div>
        <div class="photo-band-grid">
          {band.images.map((image) => (
            <figure>
              <Picture src={image.src} alt={image.alt} sizes="(max-width: 900px) 50vw, 25vw" />
            </figure>
          ))}
        </div>
        {band.link && (
          <p class="photo-band-link">
            <a class="btn btn-navy" href="/family">Meet the Rapid Water Heater Family</a>
          </p>
        )}
        {cta && <CtaRow label={`${pageKey(Astro.url.pathname)}_photo_band_cta_phone_button`} quoteHref={quoteHref} />}
      </div>
    </section>
  )
}
