<style>
  .socials {
    margin: 28px 0 0;
    padding-top: 22px;
    border-top: 1px solid rgba(128, 128, 128, 0.25);
  }
  .socials-title {
    margin: 0 0 12px;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: inherit;
    opacity: 0.85;
  }
  .socials-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .socials-link {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 9px 15px;
    border: 1px solid rgba(128, 128, 128, 0.3);
    border-radius: 999px;
    color: inherit;
    text-decoration: none;
    font-size: 0.92rem;
    line-height: 1;
    transition: border-color 0.18s ease, transform 0.18s ease, background-color 0.18s ease;
  }
  .socials-link:hover,
  .socials-link:focus-visible {
    border-color: currentColor;
    background-color: rgba(128, 128, 128, 0.12);
    transform: translateY(-1px);
  }
  .socials-link svg {
    flex: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .socials-link {
      transition: none;
    }
    .socials-link:hover,
    .socials-link:focus-visible {
      transform: none;
    }
  }
  @media (max-width: 480px) {
    .socials-link span {
      display: none;
    }
    .socials-link {
      padding: 10px;
    }
  }
</style>
