---
// Glass footer. Same links and contact lines as before; colours and layout come from the design tokens.
import Picture from './Picture.astro';
import Socials from './Socials.astro';
import { phoneHref, site } from '../lib/site';
import { callClick } from '../lib/track';
---
<footer class="site-footer">
  <div class="container">
    <div class="panel">
      <div class="footer-grid">
        <div class="footer-brand">
          <a href="/" class="logo">
            <Picture src="/images/mascot-logo.png" alt={`${site.business.name} mascot`} class="logo-mark" />
            <span>{site.brand.logoText}</span>
          </a>
          <p>Hot water now. No monkey business! Family-owned plumbing &amp; water heater installation serving Southwest Florida.</p>
          <div class="footer-social">
            <a href={site.business.googleMapsUrl} target="_blank" rel="noopener" aria-label={`${site.brand.logoText} on Google`}><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.6 12.23c0-.71-.06-1.4-.18-2.05H12v3.88h5.38a4.6 4.6 0 0 1-2 3.02v2.5h3.24c1.9-1.75 2.98-4.32 2.98-7.35Z"></path><path d="M12 22c2.7 0 4.96-.9 6.62-2.42l-3.24-2.5c-.9.6-2.04.95-3.38.95-2.6 0-4.8-1.76-5.59-4.12H3.07v2.58A10 10 0 0 0 12 22Z"></path><path d="M6.41 13.91a6 6 0 0 1 0-3.82V7.51H3.07a10 10 0 0 0 0 8.98l3.34-2.58Z"></path><path d="M12 5.98c1.47 0 2.79.5 3.83 1.5l2.87-2.88A9.6 9.6 0 0 0 12 2a10 10 0 0 0-8.93 5.51l3.34 2.58C7.2 7.74 9.4 5.98 12 5.98Z"></path></svg><span>Google</span></a>
          </div>
        </div>
        <div class="footer-col">
          <h2 class="fh">Services</h2>
          <ul>
            <li><a href="/services/water-heater-installation">Water Heater Installation</a></li>
            <li><a href="/services/tankless-water-heater-installation">Tankless Water Heaters</a></li>
            <li><a href="/services/same-day-water-heaters">Same-Day Water Heaters</a></li>
            <li><a href="/services/drain-cleaning">Drain Cleaning</a></li>
            <li><a href="/services/emergency-plumbing">Emergency Plumbing</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h2 class="fh">Company</h2>
          <ul>
            <li><a href="/about">About Us</a></li>
            <li><a href="/family">Meet the Family</a></li>
            <li><a href="/reviews">Reviews</a></li>
            <li><a href="/locations">Service Areas</a></li>
            <li><a href="/contact">Contact</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h2 class="fh">Contact</h2>
          <ul class="footer-contact">
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"></path></svg><a href={phoneHref(site.business.phone)} onclick={callClick('footer_phone_button')}>{site.business.phone}</a></li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path><circle cx="12" cy="10" r="3"></circle></svg><span>{site.business.address.city}, {site.business.address.region} &amp; Southwest Florida</span></li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 6v6l4 2"></path></svg><span>Flexible hours &amp; emergency service available</span></li>
          </ul>
        </div>
      </div>
      <Socials />
      <div class="footer-bottom">
        <span>© <span class="cur-year">2026</span> {site.business.name}. All rights reserved.</span>
        <span>Licensed Florida Plumbing Contractor · License #CFC1434490</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer { padding: 24px 0 40px; color: var(--text-muted); font-size: 0.95rem; }
  .panel {
    position: relative; overflow: hidden; padding: 52px 48px 26px; border-radius: var(--r-xl);
    background: radial-gradient(50% 80% at 0% 0%, rgb(53 167 255 / 0.12), transparent 70%), linear-gradient(160deg, rgb(255 255 255 / 0.08), rgb(255 255 255 / 0.02)), rgb(10 20 48 / 0.75);
    border: 1px solid var(--glass-border); box-shadow: var(--glass-edge), var(--shadow-2);
  }
  .footer-grid { display: grid; grid-template-columns: 1.5fr 1fr 1fr 1.25fr; gap: 40px; padding-bottom: 32px; }
  .logo { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; color: #fff; text-decoration: none; font: 700 1.2rem var(--font-display); }
  .logo :global(.logo-mark) { width: 42px; height: 42px; border-radius: 50%; background: #fff; padding: 2px; object-fit: contain; }
  .footer-brand p { margin: 14px 0 0; max-width: 34ch; color: var(--text); }
  .footer-social { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 18px; }
  .footer-social a {
    display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 16px; border-radius: var(--r-pill);
    border: 1px solid var(--glass-border-strong); background: rgb(255 255 255 / 0.06); color: #fff;
    font-size: 0.85rem; font-weight: 700; text-decoration: none;
  }
  .footer-social a:hover { border-color: var(--gold); color: var(--gold-hi); }
  .footer-social svg { width: 17px; height: 17px; }
  .fh { margin: 0 0 14px; font: 700 0.8rem/1.3 var(--font-sans); letter-spacing: 0.14em; text-transform: uppercase; color: var(--gold-hi); }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  li { margin: 0; }
  .footer-col a { display: inline-flex; align-items: center; min-height: 40px; color: var(--text); text-decoration: none; }
  .footer-col a:hover { color: var(--gold-hi); }
  .footer-contact li { display: flex; align-items: center; gap: 10px; min-height: 40px; color: var(--text); }
  .footer-contact svg { width: 18px; height: 18px; flex: none; color: var(--gold); }
  .footer-bottom { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 10px 20px; margin-top: 26px; padding-top: 20px; border-top: 1px solid var(--glass-border); font-size: 0.85rem; }
  .panel :global(.socials) { border-top-color: var(--glass-border); }
  @media (max-width: 900px) { .footer-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 760px) { .site-footer { padding-bottom: 104px; } }
  @media (max-width: 560px) { .footer-grid { grid-template-columns: 1fr; gap: 26px; } .panel { padding: 34px 22px 22px; border-radius: var(--r-lg); } }
</style>
